<Page
    x:Class="Agropecuaria_CM.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Agropecuaria_CM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Padding="20" VerticalAlignment="Top">
            <Button Content="Atrás" Click="BackButton_Click" />
            <TextBlock x:Name="TitleText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24" Spacing="20">

                <Grid Width="360" Height="360" HorizontalAlignment="Center" CornerRadius="12">
                    <Image x:Name="DestinationImage" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                    <Border x:Name="FallbackBorder" 
                            Background="{ThemeResource SystemControlHighlightAccentBrush}" 
                            Visibility="Collapsed" 
                            CornerRadius="10">
                        <TextBlock Text="{Binding ProductName}" 
                                   Foreground="White" 
                                   FontSize="24" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock x:Name="BrandText" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TypeText" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DescText" TextWrapping="Wrap" FontSize="16" HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <StackPanel Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="15" CornerRadius="8">
                            <TextBlock Text="Precio Venta" FontSize="12"/>
                            <TextBlock x:Name="PriceText" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Name="UnitText" FontSize="12" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>