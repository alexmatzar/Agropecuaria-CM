<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Agropecuaria_CM.ProductListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Agropecuaria_CM"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Agropecuaria_CM.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="12">
                <GridView x:ConnectionId='2' x:Name="ProductsGridView"
                          IsItemClickEnabled="True"
                                                                
                          SelectionMode="None"
                                                                      
                          animations:Connected.ListItemElementName="ItemThumbnail">

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <!-- Usamos DataType para aprovechar x:Bind si lo quieres; ahora Product es accesible -->
                        <DataTemplate                            >
                            <StackPanel Width="180" Height="250" HorizontalAlignment="Left" Margin="8">
                                <Border x:Name="ItemThumbnail"
                                        Width="180" Height="225"
                                        CornerRadius="8"
                                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                        HorizontalAlignment="Center"
                                animations:Connected.ListItemKey="{Binding ProductName}">
                                    <TextBlock Text="{Binding ProductName}"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="8"/>
                                </Border>

                                <TextBlock Text="{Binding ProductBrand}"
                                           Margin="4,8,4,0"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

