<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Agropecuaria_CM.ConfigPage9"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Agropecuaria_CM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="20" RowSpacing="20">
        <!-- Row Definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section with App Information -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" CornerRadius="15">
            <Image Source="Assets/LOGO-AgrocomercialMendoza.jpg" Width="250" Height="250" Stretch="Uniform" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="AgroComercial Mendoza" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Configuración General" FontSize="18" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Visible">
            <!-- Settings Section -->
            <Grid ColumnSpacing="20" RowSpacing="20">
                <!-- Grid Definitions -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Background and Notifications Settings -->
                <Grid Grid.Column="0" Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}" Padding="20" CornerRadius="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.6*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="5">
                        <TextBlock Text="Información" FontWeight="SemiBold" FontSize="20"/>
                        <TextBlock Text="Versión para Windows 11, versión 1.0" FontWeight="ExtraLight" FontSize="20"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="5">
                        <TextBlock Text="Personalización" FontSize="20" FontWeight="SemiBold"/>

                        <!-- Change Background Section -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE91B;" FontSize="24" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Cambiar Fondo de Aplicación" FontSize="16"/>
                                <Button x:ConnectionId='8' Content="Seleccionar imagen de fondo"                                    />
                            </StackPanel>
                        </StackPanel>

                        <!-- Notifications Threshold Section -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7F4;" FontSize="24" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Configurar Umbral de Notificaciones" FontSize="16"/>
                                <Button x:ConnectionId='7' Content="Configurar"                         />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Backup and Security Settings -->
                <Grid Grid.Column="1" Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}" Padding="20" CornerRadius="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1.3*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" Spacing="10">
                        <TextBlock Text="Respaldo y Seguridad" FontSize="20" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <FontIcon Glyph="&#xE7C3;" FontSize="24" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Copias de Seguridad" FontSize="16"/>
                                <Button x:ConnectionId='5' Content="Realizar una copia de seguridad"                                     />
                                <Button x:ConnectionId='6' Content="Seleccionar y usar copia de seguridad"                                      />
                            </StackPanel>
                        </StackPanel>

                        <!-- Security Settings Section -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Seguridad de Ventanas" FontSize="16"/>
                                <Button x:ConnectionId='3' Content="Configurar seguridad de ventanas"                                  />
                                <Button x:ConnectionId='4' x:Name="PinAccessButton"                              />
                            </StackPanel>
                        </StackPanel>

                        <Button x:ConnectionId='2' Content="Cerrar Sesión" Background="Red" Foreground="White"                            HorizontalAlignment="Center" Width="150"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

